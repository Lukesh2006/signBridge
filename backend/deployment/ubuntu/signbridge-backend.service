[Unit]
Description=SignBridge FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signbridge
Group=signbridge
WorkingDirectory=/opt/signbridge/backend
EnvironmentFile=/etc/signbridge/signbridge.env
# Listen on localhost only; Cloudflare Tunnel is the only way in from the internet.
# --proxy-headers makes rate limits use each visitor's real IP from the tunnel.
ExecStart=/opt/signbridge/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 5000 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5

# Basic hardening: the service can only write to its data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signbridge

[Install]
WantedBy=multi-user.target
