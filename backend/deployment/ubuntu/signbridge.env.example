# Copy to /etc/signbridge/signbridge.env (install.sh does this) and adjust.
# Readable only by root and the signbridge service user.

# The website that is allowed to call this API.
ALLOWED_ORIGINS=https://signbridgeco.xyz,https://www.signbridgeco.xyz

# Firebase files (see docs/self-hosting-ubuntu.md, step 2). Never commit them.
FIREBASE_CONFIG_PATH=/etc/signbridge/firebase.json
FIREBASE_ADMIN_PATH=/etc/signbridge/firebase-admin.json

# Personal-sign recordings and trained models (training_samples/, personal_models/).
SIGNBRIDGE_DATA_DIR=/var/lib/signbridge

# Optional: the separate 76-word model server. Leave empty if you don't run one;
# personal signs still work without it.
BASE_URL=

# Optional: enables the admin-only endpoints. Use a long random value, or leave empty.
ADMIN_API_KEY=
