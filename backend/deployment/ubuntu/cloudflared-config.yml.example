# Copy to /etc/cloudflared/config.yml and replace TUNNEL_ID (twice).
# See docs/self-hosting-ubuntu.md, step 5.
tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

ingress:
  # Public API (REST + WebSocket) -> backend on this laptop.
  - hostname: api.signbridgeco.xyz
    service: http://127.0.0.1:5000
  # Anything else is refused.
  - service: http_status:404
